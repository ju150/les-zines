# En-têtes HTTP appliqués par Cloudflare (Workers Static Assets).
# Format : un motif de chemin, puis les en-têtes indentés de deux espaces.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Report-Only d'abord : surveiller la console sur le site déployé, puis renommer en
  # Content-Security-Policy une fois qu'aucune ressource légitime n'est bloquée.
  # 'unsafe-inline' est requis par les scripts inline d'Astro ; frame-src pour Google Maps et
  # le film de Lège-Cap Ferret ; script-src youtube.com pour l'API IFrame de ce film, chargée
  # seulement au clic (YouTubeEmbed.astro).
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://www.google.com https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; form-action 'self'

# Cache long pour les fichiers statiques immuables
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos : une semaine, sans « immutable » — une photo remplacée garde le même nom de fichier.
/photos/*
  Cache-Control: public, max-age=604800

# Jeu de caractères explicite pour la fiche destinée aux assistants IA. Cloudflare servait
# ce fichier en « text/plain » tout court : un client qui se fie à l'en-tête (la bibliothèque
# Python requests, par exemple) le décodait alors en ISO-8859-1 et lisait « LÃ¨ge-Cap-Ferret ».
# Un fichier texte n'a pas de balise <meta charset> pour se rattraper, contrairement aux pages.
/llms.txt
  Content-Type: text/plain; charset=utf-8
