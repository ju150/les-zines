{
  // Cloudflare Workers (Static Assets) — @astrojs/cloudflare v14 déploie un Worker,
  // pas un projet Pages. L'adaptateur complète cette configuration au build :
  // `main` (dist/server/entry.mjs) et `assets` (dist/client) sont générés dans
  // dist/server/wrangler.json — ne pas les redéclarer ici.
  //
  // `nodejs_compat` fournit les API Node au runtime. L'endpoint de réservation lit
  // ses variables via `import { env } from 'cloudflare:workers'`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "les-zines",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // ——— Variables non sensibles ———
  // Elles vivent ici et PAS dans le tableau de bord, pour une raison précise :
  // `wrangler deploy` remplace les variables du Worker par celles de ce fichier.
  // Une variable saisie uniquement dans l'interface est donc effacée au
  // déploiement suivant — c'est ce qui a fait échouer les premiers essais d'envoi.
  // Ces trois valeurs sont de toute façon publiques : les deux adresses sont
  // affichées sur la page Contact.
  //
  // Les secrets, eux, sont gérés à part par Cloudflare (Settings → Variables and Secrets,
  // type « Secret », ou `npx wrangler secret put <NOM> --name les-zines`), survivent aux
  // déploiements et n'ont rien à faire dans le dépôt :
  //   RATES_SHEET_CSV_URL  adresse d'export CSV de la feuille Google des tarifs
  //   RESEND_API_KEY       envoi des e-mails de réservation
  //   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM, TWILIO_TO  SMS (optionnels)
  // Modèle commenté pour le développement local : .env.example.
  "vars": {
    "RESERVATION_FROM": "Villa Les Zines <reservation@leszines.fr>",
    "RESERVATION_TO": "contact@leszines.fr",
    "CONTACT_EMAIL": "contact@leszines.fr"
  }
}
