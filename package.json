{
  "name": "les-zines",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Site de location de la Villa Les Zines au Cap Ferret : Astro, bilingue FR/EN, déployé sur Cloudflare Workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run photos && astro dev",
    "build": "npm run photos && astro build",
    "preview": "astro preview",
    "photos": "node scripts/photo-manifest.mjs",
    "check": "npm run photos && astro check",
    "test": "vitest run",
    "audit:seo": "node scripts/seo-audit.mjs",
    "verify": "npm run check && npm test && npm run build && npm run audit:seo",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "flatpickr": "^4.6.13",
    "gsap": "^3.12.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "autoprefixer": "^10.6.1",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
