# ——— Réservation : e-mail ———
# Option A (recommandée si déjà utilisée) : BREVO / ex-Sendinblue.
#   → app.brevo.com → SMTP & API → créer une clé API v3. Valider l'expéditeur (BREVO_FROM).
BREVO_API_KEY=
BREVO_FROM=contact@leszines.fr
BREVO_FROM_NAME=Villa Les Zines
#
# Option B : Resend (resend.com), vérifier le domaine leszines.fr puis générer une clé.
RESEND_API_KEY=
RESERVATION_FROM=Villa Les Zines <reservation@leszines.fr>
#
# Destinataire des demandes (commun aux deux options) :
RESERVATION_TO=contact@leszines.fr

# ——— Réservation : SMS (Twilio) — optionnel ———
# Créer un compte sur twilio.com, acheter/valider un numéro, récupérer SID + token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
TWILIO_TO=+336XXXXXXXX

# Copier ce fichier en `.env` et remplir les valeurs. Tant que rien n'est renseigné,
# le formulaire bascule automatiquement sur l'ouverture d'un e-mail pré-rempli (aucune panne).
