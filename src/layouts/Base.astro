---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  transparentNav?: boolean;
  /** Social-share image, absolute path from site root. Defaults to the villa OG card. */
  image?: string;
  /** Pages kept out of search engines (404, internal tools). Skips canonical/hreflang too. */
  noindex?: boolean;
}
const { lang, title, description = '', transparentNav = false, image = '/photos/og.jpg', noindex = false } = Astro.props;
const t = useTranslations(lang);

// Canonical + hreflang. Pages are prerendered, so Astro.url.pathname is the route
// path at build time. Netlify 301s "/la-villa" → "/la-villa/", so the trailing-slash
// form is the canonical one.
const site = Astro.site ?? new URL('https://www.leszines.fr');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, site).href;
const barePath = path === '/en/' ? '/' : path.startsWith('/en/') ? path.slice(3) : path;
const frUrl = new URL(barePath, site).href;
const enUrl = new URL(barePath === '/' ? '/en/' : '/en' + barePath, site).href;
const ogImage = new URL(image, site).href;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_GB';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/*
      Polices visibles dès le premier écran, préchargées pour qu'elles arrivent avec le
      HTML au lieu d'attendre l'analyse de la CSS. Sans ça, la page s'affichait d'abord
      en Georgia / system-ui puis basculait au bout d'une seconde : le grand h1 du hero
      (Cormorant Garamond 600) et la marque de la barre de navigation (Playfair italic
      600) changeaient de largeur, et toute la mise en page sautait.
      Seul le sous-ensemble « latin » est préchargé : « latin-ext » ne sert qu'à des
      caractères rares, absents des textes du site. `crossorigin` est obligatoire sur
      un préchargement de police, même en même origine — sans lui le fichier est
      téléchargé deux fois.
    */}
    <link rel="preload" href="/fonts/cormorant-garamond-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-italic-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="fr" href={frUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={frUrl} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Villa Les Zines" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#123F39" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-3 focus:left-3 focus:bg-white focus:text-ink focus:px-4 focus:py-2 focus:rounded-full">{t('skip')}</a>
    <Nav lang={lang} transparent={transparentNav} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Reveal-on-scroll via a rAF-throttled scroll sweep. Bulletproof: any .reveal that
      // enters the viewport gets .is-in, regardless of scroll speed (IntersectionObserver
      // can skip elements on very fast scroll/jumps). CSS handles the animation + reduced-motion.
      const pending = () => document.querySelectorAll('.reveal:not(.is-in)');
      const sweep = () => {
        const vh = window.innerHeight;
        pending().forEach((el) => {
          if ((el as HTMLElement).getBoundingClientRect().top < vh * 0.9) el.classList.add('is-in');
        });
      };
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { sweep(); ticking = false; });
      };
      const init = () => {
        sweep();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      };
      if (document.readyState !== 'loading') init();
      else document.addEventListener('DOMContentLoaded', init);
      window.addEventListener('load', sweep);
    </script>
  </body>
</html>
