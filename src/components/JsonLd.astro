---
// Renders a schema.org JSON-LD block. Valid anywhere in the document.
// « < » est écrit < : un texte contenant « </script> » fermerait sinon la balise et
// laisserait la suite du JSON s'afficher dans la page. JSON.parse relit < comme « < ».
interface Props { data: unknown }
const { data } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
