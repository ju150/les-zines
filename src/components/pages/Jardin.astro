---
// Liste des photos générée au build par scripts/photo-manifest.mjs. Surtout pas
// un `fs.readdirSync` ici : le pré-rendu de l'adaptateur Cloudflare tourne dans le
// runtime Workers, sans accès disque — le scan y renvoyait une galerie vide.
import photoManifest from '../../data/photos.json';
import type { Lang } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';
import Lightbox from '../Lightbox.astro';
import JsonLd from '../JsonLd.astro';
import { breadcrumbSchema } from '../../data/schema';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';

// Family photos of the garden (01.jpg = the featured « avant » shot), plus the
// original pro shots. New drops in public/photos/villa/jardin/ appear automatically.
const manifest = photoManifest as Record<string, string[]>;
const jardinPhotos = manifest.jardin ?? [];
// Les terrasses font partie des extérieurs : leurs photos ont leur place ici aussi
// (comme le jardin apparaît dans le chapitre Terrasses de la page Villa).
const terrassesPhotos = manifest.terrasses ?? [];
const gallery = [
  ...(jardinPhotos.length ? [jardinPhotos[0]] : []),
  '/photos/jardin-1.webp',
  '/photos/jardin-2.webp',
  '/photos/jardin-3.webp',
  '/photos/jardin-5.webp',
  '/photos/terrasse.webp',
  '/photos/villa-jardin.webp',
  ...jardinPhotos.slice(1),
  ...terrassesPhotos,
];
---
<JsonLd data={breadcrumbSchema(lang, 'le-jardin', fr ? 'Le Jardin' : 'The Garden')} />
<PageHeader
  image="/photos/jardin-1.webp"
  eyebrow={fr ? 'Le Jardin & les extérieurs' : 'The Garden & outdoors'}
  title={fr ? '700 m² de pins, d’ombre et de soleil.' : '700 m² of pines, shade and sun.'}
  intro={fr
    ? 'Un jardin clos et arboré, plusieurs terrasses en bois, un barbecue, des transats et des hamacs.'
    : 'A walled, tree-lined garden, several wood terraces, a barbecue, sun loungers and hammocks.'}
/>

<section class="py-20 sm:py-28">
  <div class="wrap max-w-3xl">
    <p class="lead reveal">
      {fr
        ? 'Le jardin est clos par une murette surmontée d’une palissade en bois, et planté de pins et d’arbres fruitiers. Plusieurs terrasses en caillebotis complètent l’aménagement : des coins ombragés pour les repas, des zones 100 % soleil pour le bronzage. Un barbecue, trois tables de jardin, seize fauteuils, des transats, deux hamacs et de grands parasols équipent les lieux.'
        : 'The garden is enclosed by a low wall topped with a wooden fence, and planted with pines and fruit trees. Several wood-deck terraces complete the setup: shaded corners for meals, full-sun zones for sunbathing. A barbecue, three garden tables, sixteen armchairs, sun loungers, two hammocks and large parasols equip the space.'}
    </p>
  </div>
</section>

<section class="pb-28">
  <div class="wrap grid grid-cols-2 lg:grid-cols-3 gap-4">
    {gallery.map((g, i) => (
      <figure class:list={['overflow-hidden rounded-2xl reveal', i === 0 && 'col-span-2 lg:col-span-2 lg:row-span-2']}>
        <img src={g} alt={fr ? 'Le jardin et les terrasses de la villa' : 'The villa’s garden and terraces'}
             class="js-lb w-full h-full object-cover aspect-[4/3] cursor-pointer hover:scale-[1.05] transition-transform duration-700 ease-smooth" loading="lazy" />
      </figure>
    ))}
  </div>
</section>

<Lightbox lang={lang} />
