---
import fs from 'node:fs';
import type { Lang } from '../../i18n/ui';
import { localizedPath } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';

const features = [
  { fr: ['6 chambres + dortoir', 'Lits 160×200, dortoir 4 couchages 80×200'], en: ['6 bedrooms + dorm', '160×200 beds, dorm sleeps 4 in 80×200'] },
  { fr: ['12 à 16 couchages', 'Toutes les chambres sont climatisées'], en: ['Sleeps 12 to 16', 'All bedrooms are air-conditioned'] },
  { fr: ['Pièce de vie 60 m²', 'Cuisine équipée ouverte sur la terrasse'], en: ['60 m² living room', 'Open fitted kitchen onto the terrace'] },
  { fr: ['4 salles d’eau', '+ une douche et un WC extérieurs'], en: ['4 bathrooms', '+ an outdoor shower and WC'] },
  { fr: ['Climatisation', 'Dans toute la maison'], en: ['Air conditioning', 'Throughout the house'] },
  { fr: ['Grandes terrasses', 'Caillebotis bois, plein sud'], en: ['Large terraces', 'Wood decking, south-facing'] },
  { fr: ['Wifi fibre', 'Connexion fibre dans toute la villa'], en: ['Fibre wifi', 'Fibre connection throughout the villa'] },
  { fr: ['Chambre et salle d’eau accessibles', 'Une chambre et une salle d’eau de plain-pied (PMR)'], en: ['Accessible bedroom & bathroom', 'A ground-floor bedroom and bathroom'] },
];

const themeDefs = [
  { slug: 'vie-cuisine', fr: 'Pièce de vie & cuisine', en: 'Living space & kitchen' },
  { slug: 'chambres', fr: 'Chambres & dortoir', en: 'Bedrooms & dorm' },
  { slug: 'sdb', fr: 'Salles d’eau', en: 'Bathrooms' },
  { slug: 'terrasses', fr: 'Terrasses', en: 'Terraces' },
];
const themes = themeDefs
  .map((d) => {
    const dir = `public/photos/villa/${d.slug}`;
    const photos = fs.existsSync(dir)
      ? fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp)$/i.test(f)).sort().map((f) => `/photos/villa/${d.slug}/${f}`)
      : [];
    return { ...d, photos };
  })
  .filter((t) => t.photos.length);

const cover = themes.find((t) => t.slug === 'vie-cuisine')?.photos[0] || '/photos/terrasse.jpeg';
---
<PageHeader
  image={cover}
  eyebrow={fr ? 'La Villa' : 'The Villa'}
  title={fr ? 'Une grande maison en bois, esprit Bassin.' : 'A large timber house, esprit Bassin.'}
  intro={fr
    ? 'Six chambres, une vaste pièce de vie et de grandes terrasses : la villa accueille 12 à 16 personnes en toute liberté.'
    : 'Six bedrooms, a vast living space and large terraces: the villa welcomes 12 to 16 people in total freedom.'}
/>

<section class="py-20 sm:py-28">
  <div class="wrap grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
    <div class="reveal">
      <p class="eyebrow mb-4">{fr ? 'L’intérieur' : 'Inside'}</p>
      <h2 class="h2 mb-5">{fr ? 'Tout le monde sous le même toit.' : 'Everyone under one roof.'}</h2>
      <p class="lead">
        {fr
          ? 'Au rez-de-chaussée, une grande pièce de vie de 60 m² prolonge la cuisine ouverte vers la terrasse et le jardin. À l’étage et dans l’aile, les six chambres climatisées et le grenier-dortoir offrent de vrais espaces à chacun, parfait pour deux familles ou une grande tablée d’amis.'
          : 'On the ground floor, a large 60 m² living room extends the open kitchen towards the terrace and garden. Upstairs and in the wing, the six air-conditioned bedrooms and the attic dorm give everyone real space, perfect for two families or a big gathering of friends.'}
      </p>
    </div>
    <ul class="grid sm:grid-cols-2 gap-x-8 reveal">
      {features.map((f) => (
        <li class="py-4 border-b border-line flex gap-3">
          <svg class="w-5 h-5 mt-1 shrink-0 stroke-pine-2 fill-none" stroke-width="1.6" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          <span><b class="text-ink font-semibold">{fr ? f.fr[0] : f.en[0]}</b><br /><span class="text-ink-soft text-sm">{fr ? f.fr[1] : f.en[1]}</span></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Themed immersive gallery -->
<section class="pb-8">
  <div class="wrap">
    <p class="eyebrow mb-3 reveal">{fr ? 'Visite en images' : 'A visual tour'}</p>
    <h2 class="h2 reveal">{fr ? 'Pièce par pièce.' : 'Room by room.'}</h2>
  </div>
</section>

{themes.map((theme) => (
  <section class="pb-16 sm:pb-20">
    <div class="wrap">
      <div class="flex items-baseline justify-between gap-4 mb-5 reveal">
        <h3 class="font-serif text-2xl sm:text-3xl">{fr ? theme.fr : theme.en}</h3>
        <span class="text-sm text-ink-mute">{theme.photos.length} {fr ? 'photos' : 'photos'}</span>
      </div>
      <div class="gal-masonry">
        {theme.photos.map((src) => (
          <figure class="gal-fig">
            <img src={src} class="gal-img" data-full={src} alt={fr ? theme.fr : theme.en} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>
))}

<section class="pb-28">
  <div class="wrap text-center">
    <a href={localizedPath(lang, 'reservation')} class="btn btn-primary">{fr ? 'Réserver un séjour' : 'Book a stay'}</a>
  </div>
</section>

<!-- Lightbox -->
<div id="lightbox" class="lb" aria-hidden="true">
  <button class="lb-btn lb-close" aria-label="Fermer">&times;</button>
  <button class="lb-btn lb-prev" aria-label="Précédent">&#8249;</button>
  <img class="lb-img" alt="" />
  <button class="lb-btn lb-next" aria-label="Suivant">&#8250;</button>
</div>

<style>
  .gal-masonry { column-gap: 0.75rem; columns: 2; }
  @media (min-width: 768px) { .gal-masonry { columns: 3; } }
  @media (min-width: 1280px) { .gal-masonry { columns: 4; } }
  .gal-fig { break-inside: avoid; margin: 0 0 0.75rem; }
  .gal-img { @apply w-full rounded-xl cursor-pointer transition duration-500 ease-smooth; }
  .gal-img:hover { transform: scale(1.02); filter: brightness(1.03); }

  .lb { position: fixed; inset: 0; z-index: 100; background: rgba(14,50,45,.95); display: none; align-items: center; justify-content: center; padding: 4vw; }
  .lb.open { display: flex; }
  .lb-img { max-width: 92vw; max-height: 88vh; object-fit: contain; border-radius: 6px; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .lb-btn { position: absolute; background: rgba(255,255,255,.12); color: #fff; border: none; width: 52px; height: 52px; border-radius: 50%; font-size: 1.9rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s; }
  .lb-btn:hover { background: rgba(255,255,255,.28); }
  .lb-close { top: 20px; right: 20px; }
  .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>

<script>
  const imgs = [...document.querySelectorAll('.gal-img')] as HTMLImageElement[];
  const lb = document.getElementById('lightbox')!;
  const lbImg = lb.querySelector('.lb-img') as HTMLImageElement;
  let idx = 0;
  const show = () => { lbImg.src = imgs[idx].dataset.full || imgs[idx].src; };
  const open = (i: number) => { idx = i; show(); lb.classList.add('open'); document.body.style.overflow = 'hidden'; };
  const close = () => { lb.classList.remove('open'); document.body.style.overflow = ''; };
  const go = (d: number) => { idx = (idx + d + imgs.length) % imgs.length; show(); };
  imgs.forEach((im, i) => im.addEventListener('click', () => open(i)));
  lb.querySelector('.lb-close')!.addEventListener('click', close);
  lb.querySelector('.lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); go(-1); });
  lb.querySelector('.lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); go(1); });
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') go(-1);
    else if (e.key === 'ArrowRight') go(1);
  });
</script>
