---
import fs from 'node:fs';
import type { Lang } from '../../i18n/ui';
import { localizedPath } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';
import Lightbox from '../Lightbox.astro';
import JsonLd from '../JsonLd.astro';
import { breadcrumbSchema } from '../../data/schema';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';

const features = [
  { fr: ['6 chambres + dortoir', 'Lits 160×200, dortoir 4 couchages 80×200'], en: ['6 bedrooms + dorm', '160×200 beds, dorm sleeps 4 in 80×200'] },
  { fr: ['12 à 16 couchages', 'Toutes les chambres sont climatisées'], en: ['Sleeps 12 to 16', 'All bedrooms are air-conditioned'] },
  { fr: ['Pièce de vie 60 m²', 'Cuisine équipée ouverte sur la terrasse'], en: ['60 m² living room', 'Open fitted kitchen onto the terrace'] },
  { fr: ['4 salles d’eau', '+ une douche et un WC extérieurs'], en: ['4 bathrooms', '+ an outdoor shower and WC'] },
  { fr: ['Climatisation', 'Dans toute la maison'], en: ['Air conditioning', 'Throughout the house'] },
  { fr: ['Grandes terrasses', 'Caillebotis bois, plein sud'], en: ['Large terraces', 'Wood decking, south-facing'] },
  { fr: ['Wifi fibre', 'Connexion fibre dans toute la villa'], en: ['Fibre wifi', 'Fibre connection throughout the villa'] },
  { fr: ['Chambre et salle d’eau accessibles', 'Une chambre et une salle d’eau de plain-pied (PMR)'], en: ['Accessible bedroom & bathroom', 'A ground-floor bedroom and bathroom'] },
];

// Each theme folder's 01.jpg is the « avant » photo → used as the chapter cover.
const themeDefs = [
  { slug: 'vie-cuisine', fr: 'Pièce de vie & cuisine', en: 'Living space & kitchen' },
  { slug: 'chambres', fr: 'Chambres & dortoir', en: 'Bedrooms & dorm' },
  { slug: 'sdb', fr: 'Salles d’eau', en: 'Bathrooms' },
  { slug: 'terrasses', fr: 'Terrasses', en: 'Terraces' },
  // Réciproque de la page Jardin (qui montre les terrasses) : le jardin clôt la visite.
  { slug: 'jardin', fr: 'Le Jardin', en: 'The Garden' },
];
const themes = themeDefs
  .map((d) => {
    const dir = `public/photos/villa/${d.slug}`;
    const photos = fs.existsSync(dir)
      ? fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp)$/i.test(f)).sort().map((f) => `/photos/villa/${d.slug}/${f}`)
      : [];
    return { ...d, photos };
  })
  .filter((t) => t.photos.length);

const cover = themes.find((t) => t.slug === 'vie-cuisine')?.photos[0] || '/photos/terrasse.webp';
---
<JsonLd data={breadcrumbSchema(lang, 'la-villa', fr ? 'La Villa' : 'The Villa')} />
<PageHeader
  image={cover}
  eyebrow={fr ? 'La Villa' : 'The Villa'}
  title={fr ? 'Une grande maison en bois, esprit Bassin.' : 'A large timber house, esprit Bassin.'}
  intro={fr
    ? 'Six chambres, une vaste pièce de vie et de grandes terrasses : la villa accueille 12 à 16 personnes en toute liberté.'
    : 'Six bedrooms, a vast living space and large terraces: the villa welcomes 12 to 16 people in total freedom.'}
/>

<section class="py-20 sm:py-28">
  <div class="wrap grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
    <div class="reveal">
      <p class="eyebrow mb-4">{fr ? 'L’intérieur' : 'Inside'}</p>
      <h2 class="h2 mb-5">{fr ? 'Tout le monde sous le même toit.' : 'Everyone under one roof.'}</h2>
      <p class="lead">
        {fr
          ? 'Au rez-de-chaussée, une grande pièce de vie de 60 m² prolonge la cuisine ouverte vers la terrasse et le jardin. À l’étage et dans l’aile, les six chambres climatisées et le grenier-dortoir offrent de vrais espaces à chacun, parfait pour deux familles ou une grande tablée d’amis.'
          : 'On the ground floor, a large 60 m² living room extends the open kitchen towards the terrace and garden. Upstairs and in the wing, the six air-conditioned bedrooms and the attic dorm give everyone real space, perfect for two families or a big gathering of friends.'}
      </p>
    </div>
    <ul class="grid sm:grid-cols-2 gap-x-8 reveal">
      {features.map((f) => (
        <li class="py-4 border-b border-line flex gap-3">
          <svg class="w-5 h-5 mt-1 shrink-0 stroke-pine-2 fill-none" stroke-width="1.6" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          <span><b class="text-ink font-semibold">{fr ? f.fr[0] : f.en[0]}</b><br /><span class="text-ink-soft text-sm">{fr ? f.fr[1] : f.en[1]}</span></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ===== Editorial chapters gallery ===== -->
<section class="pb-10">
  <div class="wrap">
    <p class="eyebrow mb-3 reveal">{fr ? 'Visite en images' : 'A visual tour'}</p>
    <h2 class="h2 reveal">{fr ? 'Pièce par pièce.' : 'Room by room.'}</h2>
    <div class="flex flex-wrap gap-2 mt-6 reveal">
      {themes.map((th) => (
        <a href={`#ch-${th.slug}`} class="ch-pill">{fr ? th.fr : th.en}</a>
      ))}
    </div>
  </div>
</section>

{themes.map((theme, ti) => (
  <section id={`ch-${theme.slug}`} class="chapter scroll-mt-16 pb-14 sm:pb-20">
    <!-- Full-bleed « avant » cover with scroll parallax -->
    <div class="ch-cover relative h-[62svh] min-h-[400px] overflow-hidden">
      <img
        src={theme.photos[0]}
        data-full={theme.photos[0]}
        alt={`${fr ? theme.fr : theme.en} — Villa Les Zines`}
        class="js-lb ch-cover-img absolute inset-0 w-full h-full object-cover scale-[1.25] cursor-pointer"
        loading={ti === 0 ? 'eager' : 'lazy'}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-pine-deep/75 via-pine-deep/5 to-pine-deep/20 pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-0 pb-8 sm:pb-12 pointer-events-none">
        <div class="wrap flex items-end justify-between gap-6">
          <div>
            <p class="eyebrow !text-gold mb-2">{String(ti + 1).padStart(2, '0')} · {fr ? 'La visite' : 'The tour'}</p>
            <h3 class="font-serif text-white text-[clamp(1.9rem,4.6vw,3.4rem)] leading-tight drop-shadow-[0_2px_20px_rgba(0,0,0,.35)]">{fr ? theme.fr : theme.en}</h3>
          </div>
          <div class="hidden sm:flex items-center gap-2.5 text-white/90 text-sm whitespace-nowrap">
            {theme.photos.length} photos
            <svg class="w-9 h-9 p-2 rounded-full border border-white/40 stroke-current fill-none animate-nudge" stroke-width="1.8" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Horizontal filmstrip (drag / swipe / arrows) -->
    <div class="relative">
      <div class="strip flex gap-3 overflow-x-auto py-5 px-[max(4vw,1rem)]" data-strip>
        {theme.photos.slice(1).map((src) => (
          <img
            src={src}
            data-full={src}
            alt={`${fr ? theme.fr : theme.en} — Villa Les Zines`}
            class="js-lb strip-img snap-start shrink-0 h-[240px] sm:h-[320px] w-auto rounded-xl cursor-pointer"
            loading="lazy"
            draggable="false"
          />
        ))}
      </div>
      <button class="strip-btn strip-prev" aria-label={fr ? 'Photos précédentes' : 'Previous photos'}>&#8249;</button>
      <button class="strip-btn strip-next" aria-label={fr ? 'Photos suivantes' : 'Next photos'}>&#8250;</button>
    </div>
  </section>
))}

<!-- ===== Le plan ===== -->
<section id="plan" class="py-16 sm:py-20 bg-paper scroll-mt-16">
  <div class="wrap">
    <div class="max-w-2xl mb-8 reveal">
      <p class="eyebrow mb-3">{fr ? 'S’y projeter' : 'Picture yourself'}</p>
      <h2 class="h2 mb-4">{fr ? 'Le plan de la villa.' : 'The villa’s floor plan.'}</h2>
      <p class="lead">
        {fr
          ? 'La pièce de vie au centre, les chambres réparties entre la maison, l’étage et l’aile, le dortoir en annexe : un plan pensé pour vivre ensemble sans se marcher dessus. Cliquez pour zoomer.'
          : 'The living space at the centre, bedrooms spread between the house, the upper floor and the wing, the dorm in the annexe: a layout made for living together with room to breathe. Click to zoom.'}
      </p>
    </div>
    <figure class="card overflow-hidden shadow-soft reveal">
      <img
        src="/photos/plan.webp"
        alt={fr ? 'Plan de la Villa Les Zines : pièce de vie, chambres, dortoir et jardin' : 'Floor plan of Villa Les Zines: living space, bedrooms, dorm and garden'}
        class="js-lb w-full h-auto cursor-zoom-in bg-white"
        loading="lazy"
        width="1960" height="1410"
      />
      <figcaption class="px-5 py-3 border-t border-line text-sm text-ink-mute">
        {fr ? 'Plan d’ensemble — rez-de-chaussée, étage et grenier-dortoir (accès extérieur).' : 'Overview plan — ground floor, upper floor and attic dorm (outdoor access).'}
      </figcaption>
    </figure>
  </div>
</section>

<section class="pb-28 pt-16">
  <div class="wrap text-center">
    <a href={localizedPath(lang, 'reservation')} class="btn btn-primary">{fr ? 'Réserver un séjour' : 'Book a stay'}</a>
  </div>
</section>

<Lightbox lang={lang} />

<style>
  .ch-pill { @apply inline-block rounded-full border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition-all duration-300; }
  .ch-pill:hover { @apply bg-pine text-white border-pine -translate-y-0.5 shadow-soft; }

  .strip { scroll-snap-type: x mandatory; scrollbar-width: thin; cursor: grab; }
  .strip.dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .strip-img { transition: transform .5s cubic-bezier(.2,.7,.2,1), filter .5s; }
  .strip-img:hover { transform: translateY(-4px); filter: brightness(1.04); }

  .strip-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 46px; height: 46px; border-radius: 50%; border: none; cursor: pointer; font-size: 1.7rem; line-height: 1; display: none; align-items: center; justify-content: center; background: rgba(255,255,255,.92); color: #123F39; box-shadow: 0 6px 24px rgba(14,50,45,.18); transition: background .2s, transform .2s; }
  .strip-btn:hover { background: #123F39; color: #fff; transform: translateY(-50%) scale(1.06); }
  .strip-prev { left: 14px; }
  .strip-next { right: 14px; }
  @media (hover: hover) and (min-width: 768px) { .strip-btn { display: flex; } }

  @keyframes nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(5px); } }
  .animate-nudge { animation: nudge 2.2s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .animate-nudge { animation: none; } .strip-img { transition: none; } }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    // Cover parallax: the image is pre-scaled (1.25) so a ±8% drift never shows edges.
    document.querySelectorAll<HTMLElement>('.ch-cover').forEach((cover) => {
      const img = cover.querySelector('.ch-cover-img');
      if (!img) return;
      gsap.fromTo(img, { yPercent: -8 }, {
        yPercent: 8,
        ease: 'none',
        scrollTrigger: { trigger: cover, start: 'top bottom', end: 'bottom top', scrub: true },
      });
    });
    // Filmstrip stagger-in on first approach.
    document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
      gsap.from(strip.children, {
        opacity: 0,
        x: 40,
        duration: 0.55,
        stagger: 0.05,
        ease: 'power2.out',
        scrollTrigger: { trigger: strip, start: 'top 92%', once: true },
      });
    });
    window.addEventListener('load', () => ScrollTrigger.refresh());
  }

  // Mouse drag-to-scroll on strips (touch already scrolls natively).
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    let down = false, startX = 0, startLeft = 0, moved = 0;
    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; moved = 0; startX = e.clientX; startLeft = strip.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) { moved = Math.abs(dx); strip.classList.add('dragging'); }
      strip.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => { down = false; strip.classList.remove('dragging'); });
    // A real drag must not open the lightbox on release.
    strip.addEventListener('click', (e) => { if (moved > 8) { e.stopPropagation(); e.preventDefault(); moved = 0; } }, true);
  });

  // Arrow buttons.
  document.querySelectorAll<HTMLElement>('.strip-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const strip = btn.parentElement?.querySelector('[data-strip]');
      if (!strip) return;
      strip.scrollBy({ left: (btn.classList.contains('strip-prev') ? -1 : 1) * strip.clientWidth * 0.75, behavior: 'smooth' });
    });
  });
</script>
