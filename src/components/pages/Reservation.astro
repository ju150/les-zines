---
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizedPath } from '../../i18n/ui';
import { SITE } from '../../data/site';
import rates from '../../data/rates.json';
import { renderAvailability } from '../../scripts/availability';
import JsonLd from '../JsonLd.astro';
import { breadcrumbSchema } from '../../data/schema';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const fr = lang === 'fr';
// NOTE: this page is prerendered — query params (?week=…) don't exist at build time
// and are read client-side in the script below.
const tableHtml = renderAvailability(rates.weeks, { mode: 'select', lang });
---
<JsonLd data={breadcrumbSchema(lang, 'reservation', fr ? 'Réservation' : 'Booking')} />
<section class="pt-28 sm:pt-32 pb-6">
  <div class="wrap max-w-4xl page-in">
    <p class="eyebrow mb-3">{fr ? 'Réservation' : 'Booking'}</p>
    <h1 class="h2 mb-4">{fr ? 'Réserver votre séjour' : 'Book your stay'}</h1>
    <p class="lead">{fr
      ? 'Choisissez une semaine disponible (ou vos dates pour un court séjour hors saison), laissez vos coordonnées, et nous vous répondons rapidement pour confirmer.'
      : 'Choose an available week (or your dates for a short off-season stay), leave your details, and we’ll get back to you quickly to confirm.'}</p>
  </div>
</section>

<section class="pb-24">
  <form id="reservation-form" class="wrap max-w-4xl page-in" data-email={SITE.email} data-lang={lang} data-home={localizedPath(lang)}>
    <!-- Step 1 -->
    <div class="mb-10">
      <div class="step-h"><span class="step-n">1</span>{fr ? 'Vos semaines' : 'Your weeks'}</div>
      <p class="text-sm text-ink-mute -mt-3 mb-4">{fr ? 'Vous pouvez cocher plusieurs semaines consécutives.' : 'You can tick several consecutive weeks.'}</p>
      <div id="week-table" class="av-table card overflow-hidden" set:html={tableHtml}></div>

      <div class="mt-3 card overflow-hidden off-card">
        <label class="av-row av-pick av-offseason">
          <div class="av-c av-dates"><span class="av-label">{fr ? 'Autres dates' : 'Other dates'}</span><span class="av-sub">{fr ? 'Court séjour / hors saison' : 'Short stay / off-season'}</span></div>
          <div class="av-c av-zones"></div>
          <div class="av-c av-price"></div>
          <div class="av-c av-status"></div>
          <div class="av-c av-action"><input type="checkbox" name="week" value="offseason" id="rad-offseason" class="sr-only" /><span class="av-radio" aria-hidden="true"></span></div>
        </label>
        <div id="offseason-dates" class="hidden px-5 py-4 border-t border-line bg-paper">
          <label class="c-label">{fr ? 'Vos dates (arrivée → départ)' : 'Your dates (arrival → departure)'}</label>
          <div class="date-field">
            <svg class="date-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <input id="daterange" class="c-input date-input" placeholder={fr ? 'Choisir vos dates…' : 'Pick your dates…'} readonly />
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-3 text-xs text-ink-mute">
        <span class="font-semibold uppercase tracking-wide">{fr ? 'Zones scolaires' : 'School zones'} :</span>
        <span class="flex items-center gap-1.5"><span class="zone zone-a">A</span><span class="zone zone-b">B</span><span class="zone zone-c">C</span></span>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="mb-8">
      <div class="step-h"><span class="step-n">2</span>{fr ? 'Vos coordonnées' : 'Your details'}</div>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block"><span class="c-label">{fr ? 'Nom' : 'Name'}</span><input name="name" required autocomplete="name" class="c-input" /></label>
        <label class="block"><span class="c-label">Email</span><input name="email" type="email" required autocomplete="email" class="c-input" /></label>
        <label class="block"><span class="c-label">{fr ? 'Téléphone' : 'Phone'}</span><input name="phone" type="tel" autocomplete="tel" class="c-input" /></label>
        <label class="block"><span class="c-label">{fr ? 'Nombre de personnes' : 'Number of guests'}</span><input name="guests" type="number" min="1" max="16" class="c-input" /></label>
      </div>
      <label class="block mt-4"><span class="c-label">{fr ? 'Message' : 'Message'}</span><textarea name="message" rows="4" class="c-input" placeholder={fr ? 'Une question, une précision…' : 'A question, a detail…'}></textarea></label>
      <!-- Honeypot: hidden from humans, bots fill it and the server silently drops the request. -->
      <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>

    <div class="flex flex-wrap items-center gap-5">
      <button type="submit" class="btn btn-primary">{fr ? 'Envoyer ma demande' : 'Send my request'}</button>
      <div class="text-sm text-ink-mute">
        {fr ? 'ou appelez le' : 'or call'} <a href={`tel:${SITE.phoneIntl}`} class="text-pine font-semibold hover:text-terra">{SITE.phone}</a>
      </div>
    </div>
    <p id="form-status" class="text-sm text-ink-soft mt-4" role="status" aria-live="polite"></p>
  </form>
</section>

<style>
  .page-in { animation: pagein .5s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes pagein { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .page-in { animation: none; } }

  .step-h { @apply flex items-center gap-3 font-serif text-2xl mb-5; }
  .step-n { @apply inline-flex items-center justify-center w-8 h-8 rounded-full bg-pine text-white text-base font-sans font-semibold; }
</style>

<!-- Global on purpose: flatpickr clones the date input at runtime (altInput), which
     doesn't carry Astro's scoping attribute — scoped styles would never reach it. -->
<style is:global>
  .c-label { @apply block text-xs uppercase tracking-wide text-ink-mute mb-2 font-semibold; }
  .c-input { @apply w-full bg-white border border-line-strong rounded-xl px-4 py-3 text-ink focus:border-terra outline-none transition; }

  .date-field { @apply relative; }
  .date-ico { @apply absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-pine-2 pointer-events-none z-10; }
  .date-input { @apply !pl-11 font-serif text-lg text-pine; }
  .date-input::placeholder { @apply font-sans text-base text-ink-mute; }

  /* Checked highlight on the WHOLE rounded card: the row's inset ring was clipped
     by the card's overflow-hidden rounded corners (broken orange outline). */
  .off-card:has(input[name='week']:checked) { @apply border-terra ring-1 ring-terra; }
  .off-card .av-offseason:has(input:checked) { box-shadow: none !important; }
</style>

<script>
  import { renderAvailability } from '../../scripts/availability';
  import { showConfirmation } from '../../scripts/confirmPopup';

  const form = document.getElementById('reservation-form') as HTMLFormElement;
  const lang = form.dataset.lang || 'fr';
  const fr = lang === 'fr';
  const home = form.dataset.home || '/';
  const table = document.getElementById('week-table')!;
  const offBox = document.getElementById('offseason-dates')!;
  const status = document.getElementById('form-status')!;

  const syncOffseason = () => {
    const off = (document.getElementById('rad-offseason') as HTMLInputElement)?.checked;
    offBox.classList.toggle('hidden', !off);
  };
  form.addEventListener('change', syncOffseason);

  // flatpickr est chargé dynamiquement : si son chargement échoue (cache Vite,
  // réseau…), le calendrier manque mais le FORMULAIRE reste 100 % fonctionnel.
  Promise.all([
    import('flatpickr'),
    import('flatpickr/dist/l10n/fr.js'),
    import('flatpickr/dist/flatpickr.min.css'),
  ]).then(([{ default: flatpickr }, { French }]) => {
    flatpickr('#daterange', {
      mode: 'range', minDate: 'today', dateFormat: 'Y-m-d',
      altInput: true, altFormat: fr ? 'j F Y' : 'F j, Y',
      locale: fr ? French : 'default',
      onChange: (dates) => {
        const rad = document.getElementById('rad-offseason') as HTMLInputElement;
        if (dates.length === 2 && rad) {
          const f = (d: Date) => d.toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
          rad.value = `${fr ? 'Hors saison' : 'Off-season'} : ${f(dates[0])} → ${f(dates[1])}`;
          rad.checked = true;
          syncOffseason();
        }
      },
    });
  }).catch(() => {
    // Sans calendrier, l'utilisateur tape ses dates librement et elles sont
    // reportées sur la valeur envoyée.
    const input = document.getElementById('daterange') as HTMLInputElement | null;
    if (input) {
      input.removeAttribute('readonly');
      input.placeholder = fr ? 'Ex. : 17 octobre 2026 → 24 octobre 2026' : 'E.g.: 17 October 2026 → 24 October 2026';
      input.addEventListener('input', () => {
        const rad = document.getElementById('rad-offseason') as HTMLInputElement | null;
        if (rad && input.value.trim()) { rad.value = `${fr ? 'Hors saison' : 'Off-season'} : ${input.value.trim()}`; rad.checked = true; }
      });
    }
  });

  // The page is prerendered: the ?week= preselection must be read in the browser.
  const preselect = (wanted?: string[]) => {
    const pre = wanted ?? [new URLSearchParams(location.search).get('week') || ''].filter(Boolean);
    if (!pre.length) return;
    [...table.querySelectorAll('input[name="week"]')].forEach((i) => {
      if (pre.includes((i as HTMLInputElement).value)) (i as HTMLInputElement).checked = true;
    });
  };
  preselect();

  // Live availability from the sheet. Keep whatever the user already ticked:
  // innerHTML wipes the checkboxes, so re-check the saved values after the swap.
  fetch('/api/rates').then((r) => r.json()).then((d) => {
    if (d?.weeks?.length) {
      const picked = [...table.querySelectorAll('input[name="week"]:checked')].map((i) => (i as HTMLInputElement).value);
      table.innerHTML = renderAvailability(d.weeks, { mode: 'select', lang });
      preselect(picked.length ? picked : undefined);
    }
  }).catch(() => {});

  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn.disabled) return;
    const fd = new FormData(form);
    const weeks = fd.getAll('week').map(String);
    const data = Object.fromEntries(fd.entries()) as Record<string, string>;
    if (!weeks.length) { status.textContent = fr ? 'Merci de choisir au moins une semaine ou vos dates.' : 'Please choose at least one week or your dates.'; return; }
    // "Other dates" ticked but no dates picked yet: the checkbox still holds its
    // placeholder value — ask for real dates instead of sending "offseason".
    if (weeks.includes('offseason')) {
      status.textContent = fr ? 'Merci de choisir vos dates d’arrivée et de départ.' : 'Please pick your arrival and departure dates.';
      (offBox.querySelector('input:not([type="hidden"])') as HTMLElement | null)?.focus();
      return;
    }
    data.week = weeks.join(' + ');
    data.form = 'reservation';
    data.lang = lang;
    submitBtn.disabled = true;
    status.textContent = fr ? 'Envoi en cours…' : 'Sending…';
    try {
      const res = await fetch('/api/reservation', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (!res.ok) throw new Error('no endpoint');
      const out = await res.json().catch(() => ({}));
      status.textContent = '';
      form.reset(); offBox.classList.add('hidden');
      showConfirmation({
        fr, home,
        title: fr ? 'Demande envoyée !' : 'Request sent!',
        message: fr
          ? 'Nous avons bien reçu votre demande de réservation et revenons vers vous très vite.'
          : 'We have received your booking request and will get back to you very soon.',
        note: out.confirmation
          ? (fr
              ? 'Un e-mail de confirmation vient de vous être adressé (pensez à vérifier vos indésirables).'
              : 'A confirmation email is on its way (check your spam folder just in case).')
          : undefined,
      });
    } catch {
      const to = form.dataset.email;
      const subject = encodeURIComponent((fr ? 'Demande de réservation, ' : 'Booking request, ') + (data.week || ''));
      const body = encodeURIComponent(`${fr ? 'Nom' : 'Name'}: ${data.name}\nEmail: ${data.email}\n${fr ? 'Téléphone' : 'Phone'}: ${data.phone || ''}\n${fr ? 'Personnes' : 'Guests'}: ${data.guests || ''}\n${fr ? 'Semaine' : 'Week'}: ${data.week || ''}\n\n${data.message || ''}`);
      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
      status.textContent = fr ? 'Votre logiciel de messagerie va s’ouvrir…' : 'Your email app will open…';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
