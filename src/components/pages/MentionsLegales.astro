---
import type { Lang } from '../../i18n/ui';
import { SITE } from '../../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<section class="pt-32 pb-24">
  <div class="wrap max-w-2xl">
    <h1 class="h2 mb-8">{fr ? 'Mentions légales' : 'Legal notice'}</h1>
    <div class="space-y-6 text-ink-soft">
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Éditeur du site' : 'Site publisher'}</h2>
        <p>{SITE.name}, Cap Ferret, Bassin d’Arcachon.<br />{fr ? 'Contact' : 'Contact'} : {SITE.phone} · {SITE.email}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Hébergement' : 'Hosting'}</h2>
        <p>{fr ? 'À compléter (Netlify, Vercel ou autre hébergeur retenu).' : 'To be completed (Netlify, Vercel or the chosen host).'}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Données personnelles' : 'Personal data'}</h2>
        <p>{fr
          ? 'Les informations transmises via les formulaires servent uniquement à répondre à vos demandes de location ou de visite et ne sont ni cédées ni revendues.'
          : 'Information sent via the forms is used solely to answer your rental or visit requests and is never shared or sold.'}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Crédits photos' : 'Photo credits'}</h2>
        <p>{fr
          ? 'Photographies de la villa : famille Bernard. Photos du Cap Ferret via Wikimedia Commons : phare et presqu’île © Rundvald (CC BY-SA 4.0) ; village vu de la jetée Bélisaire © Reynald G (CC BY-SA 4.0) ; parcs à huîtres et Bassin à marée basse © Grand Parc, Bordeaux (CC BY 2.0) ; coucher de soleil sur le Bassin © www.twin-loc.fr (CC BY 2.0) ; plage océane face à la Dune du Pilat © Jörg Braukmann (CC BY-SA 4.0) ; ruelle du village © Charlotte Maranges (CC BY 4.0).'
          : 'Villa photographs: Bernard family. Cap Ferret photos via Wikimedia Commons: lighthouse and peninsula © Rundvald (CC BY-SA 4.0); village seen from the Bélisaire jetty © Reynald G (CC BY-SA 4.0); oyster beds and Bay at low tide © Grand Parc, Bordeaux (CC BY 2.0); sunset over the Bay © www.twin-loc.fr (CC BY 2.0); ocean beach facing the Dune du Pilat © Jörg Braukmann (CC BY-SA 4.0); village lane © Charlotte Maranges (CC BY 4.0).'}</p>
      </div>
    </div>
  </div>
</section>
