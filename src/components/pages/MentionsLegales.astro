---
import type { Lang } from '../../i18n/ui';
import { SITE } from '../../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<section class="pt-32 pb-24">
  <div class="wrap max-w-2xl">
    <h1 class="h2 mb-8">{fr ? 'Mentions légales' : 'Legal notice'}</h1>
    <div class="space-y-6 text-ink-soft">
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Éditeur du site' : 'Site publisher'}</h2>
        <p>{SITE.name}, {SITE.addressLine}.<br />{fr ? 'Contact' : 'Contact'} : {SITE.phone} · {SITE.email}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Hébergement' : 'Hosting'}</h2>
        <p>{fr
          ? 'Site hébergé par Cloudflare, Inc., 101 Townsend Street, San Francisco, CA 94107, États-Unis — www.cloudflare.com.'
          : 'Site hosted by Cloudflare, Inc., 101 Townsend Street, San Francisco, CA 94107, USA — www.cloudflare.com.'}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Données personnelles' : 'Personal data'}</h2>
        <p>{fr
          ? 'Les informations transmises via les formulaires servent uniquement à répondre à vos demandes de location ou de visite et ne sont ni cédées ni revendues.'
          : 'Information sent via the forms is used solely to answer your rental or visit requests and is never shared or sold.'}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Vidéo' : 'Video'}</h2>
        <p>{fr
          ? 'La page « Le Cap Ferret » présente le film « 11 villages, 1 presqu’île » de la Ville de Lège-Cap Ferret, hébergé par YouTube (Google). Le lecteur n’est chargé que si vous lancez la vidéo ; YouTube peut alors déposer des cookies, selon sa propre politique de confidentialité.'
          : 'The “Cap Ferret” page features the film “11 villages, 1 peninsula” by the Town of Lège-Cap Ferret, hosted by YouTube (Google). The player is only loaded if you play the video; YouTube may then set cookies, under its own privacy policy.'}</p>
      </div>
      <div>
        <h2 class="font-semibold text-ink mb-1">{fr ? 'Crédits photos' : 'Photo credits'}</h2>
        <p>{fr
          ? 'Photographies de la villa et du Cap : famille Bernard. Autres photos du Cap Ferret via Wikimedia Commons : phare, presqu’île et plage côté Bassin © Rundvald (CC BY-SA 4.0) ; village vu de la jetée Bélisaire © Reynald G (CC BY-SA 4.0) ; Bassin à marée basse © Grand Parc, Bordeaux (CC BY 2.0) ; coucher de soleil sur le Bassin © www.twin-loc.fr (CC BY 2.0).'
          : 'Villa and Cap photographs: Bernard family. Other Cap Ferret photos via Wikimedia Commons: lighthouse, peninsula and Bay-side beach © Rundvald (CC BY-SA 4.0); village seen from the Bélisaire jetty © Reynald G (CC BY-SA 4.0); Bay at low tide © Grand Parc, Bordeaux (CC BY 2.0); sunset over the Bay © www.twin-loc.fr (CC BY 2.0).'}</p>
      </div>
    </div>
  </div>
</section>
