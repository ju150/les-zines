---
import type { Lang } from '../../i18n/ui';
import { localizedPath } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';

const facts = [
  { n: '8', fr: ['pièces', '6 chambres + dortoir enfants'], en: ['rooms', '6 bedrooms + kids’ dorm'] },
  { n: '12–16', fr: ['couchages', 'Idéal pour deux familles'], en: ['sleeps', 'Ideal for two families'] },
  { n: '700 m²', fr: ['de terrain', 'Jardin clos et arboré'], en: ['of land', 'Walled, wooded garden'] },
  { n: '4', fr: ['salles d’eau', '+ douche & WC extérieurs'], en: ['bathrooms', '+ outdoor shower & WC'] },
  { n: 'DPE C', fr: ['GES B', 'Maison bois performante'], en: ['GHG B', 'Efficient timber house'] },
  { n: 'Centre', fr: ['du Cap Ferret', 'À pied des plages & du marché'], en: ['of Cap Ferret', 'Walk to beaches & market'] },
];

const atouts = fr
  ? [
      'Un emplacement rare, au cœur du Cap Ferret, à pied des deux plages, du marché et de la jetée',
      'L’authenticité d’une grande maison en bois « esprit Bassin », lumineuse et chaleureuse',
      'Une forte capacité d’accueil (12 à 16 personnes) et de très beaux extérieurs',
      'Un excellent rapport locatif, déjà éprouvé saison après saison',
      'Un jardin clos et arboré de 700 m², avec de multiples terrasses',
    ]
  : [
      'A rare location, in the heart of Cap Ferret, walking distance to both beaches, the market and the jetty',
      'The authenticity of a large timber “esprit Bassin” house, bright and warm',
      'High capacity (12 to 16 guests) and beautiful outdoor spaces',
      'Excellent rental yield, proven season after season',
      'A walled, wooded 700 m² garden with multiple terraces',
    ];

const slides = [
  { src: '/photos/villa-jardin.jpeg', fr: 'La villa et son jardin clos de 700 m²', en: 'The villa and its walled 700 m² garden' },
  { src: '/photos/villa/vie-cuisine/01.jpg', fr: 'La pièce de vie de 60 m², ouverte sur la terrasse', en: 'The 60 m² living space, opening onto the terrace' },
  { src: '/photos/villa/chambres/01.jpg', fr: 'Six chambres climatisées + un dortoir', en: 'Six air-conditioned bedrooms + a dorm' },
  { src: '/photos/villa/terrasses/01.jpg', fr: 'De grandes terrasses en caillebotis, plein sud', en: 'Large south-facing wood-deck terraces' },
  { src: '/photos/villa/jardin/01.jpg', fr: 'Pins et arbres fruitiers, coins d’ombre et de soleil', en: 'Pines and fruit trees, shade and sun' },
  { src: '/photos/nuit-2.jpeg', fr: 'La villa illuminée, le soir venu', en: 'The villa lit up at nightfall' },
];
---
<PageHeader
  image="/photos/nuit-1.jpeg"
  eyebrow={fr ? 'À vendre, en toute discrétion' : 'For sale, discreetly'}
  title={fr ? 'Transmettre une maison de famille.' : 'Passing on a family home.'}
  intro={fr
    ? 'La villa continue d’être louée, mais elle est aussi à vendre. Si le lieu vous touche, parlons-en simplement.'
    : 'The villa is still rented, but it is also for sale. If the place speaks to you, let’s simply talk.'}
/>

<section class="py-20 sm:py-28">
  <div class="wrap max-w-3xl">
    <p class="lead reveal">
      {fr
        ? 'Après plusieurs années de bonheur familial, nous avons décidé de transmettre ce lieu rare, au cœur du Cap Ferret. Une grande maison en bois pensée pour les grandes tablées, à quelques pas des plages, du marché et du village, prête à écrire sa prochaine histoire.'
        : 'After several years of family happiness, we have decided to pass on this rare place in the heart of Cap Ferret. A large timber house made for big gatherings, steps from the beaches, market and village, ready to write its next chapter.'}
    </p>
  </div>
</section>

<!-- Key figures -->
<section class="pb-20">
  <div class="wrap grid grid-cols-2 lg:grid-cols-3 gap-4">
    {facts.map((f) => (
      <div class="card p-6 sm:p-7 reveal">
        <div class="font-serif text-3xl sm:text-4xl text-pine leading-none mb-2">{f.n}</div>
        <div class="font-semibold text-ink">{fr ? f.fr[0] : f.en[0]}</div>
        <p class="text-ink-soft text-sm mt-0.5">{fr ? f.fr[1] : f.en[1]}</p>
      </div>
    ))}
  </div>
</section>

<!-- Photo carousel -->
<section class="pb-20">
  <div class="wrap">
    <div class="car relative overflow-hidden rounded-3xl shadow-deep reveal aspect-[4/3] sm:aspect-[16/9] max-h-[620px] w-full" data-carousel>
      {slides.map((s, i) => (
        <figure class:list={['car-slide', i === 0 && 'active']}>
          <img src={s.src} alt={fr ? s.fr : s.en} loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
          <figcaption class="car-cap">{fr ? s.fr : s.en}</figcaption>
        </figure>
      ))}
      <button class="car-btn car-prev" aria-label={fr ? 'Photo précédente' : 'Previous photo'}>&#8249;</button>
      <button class="car-btn car-next" aria-label={fr ? 'Photo suivante' : 'Next photo'}>&#8250;</button>
      <div class="car-dots">
        {slides.map((_, i) => (
          <button class:list={['car-dot', i === 0 && 'active']} data-i={i} aria-label={`Photo ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .car-slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity .9s ease; pointer-events: none; }
  .car-slide.active { opacity: 1; pointer-events: auto; }
  .car-slide img { width: 100%; height: 100%; object-fit: cover; }
  /* Slow Ken Burns drift on the visible slide */
  .car-slide.active img { animation: kenburns 7s ease-out forwards; }
  @keyframes kenburns { from { transform: scale(1); } to { transform: scale(1.07); } }

  .car-cap { position: absolute; inset-inline: 0; bottom: 0; padding: 3.2rem 1.4rem 1.1rem; color: #fff; font-size: .95rem; background: linear-gradient(to top, rgba(14,50,45,.72), transparent); }

  .car-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 46px; height: 46px; border-radius: 50%; border: none; cursor: pointer; font-size: 1.7rem; line-height: 1; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.9); color: #123F39; box-shadow: 0 6px 24px rgba(14,50,45,.2); transition: background .2s, color .2s, transform .2s; }
  .car-btn:hover { background: #123F39; color: #fff; transform: translateY(-50%) scale(1.06); }
  .car-prev { left: 14px; }
  .car-next { right: 14px; }

  .car-dots { position: absolute; bottom: 12px; right: 16px; z-index: 5; display: flex; gap: 7px; }
  .car-dot { width: 9px; height: 9px; padding: 0; border-radius: 50%; border: none; cursor: pointer; background: rgba(255,255,255,.45); transition: background .25s, transform .25s; }
  .car-dot.active { background: #fff; transform: scale(1.25); }

  @media (prefers-reduced-motion: reduce) {
    .car-slide { transition: none; }
    .car-slide.active img { animation: none; }
  }
</style>

<script>
  const car = document.querySelector<HTMLElement>('[data-carousel]');
  if (car) {
    const slides = [...car.querySelectorAll('.car-slide')];
    const dots = [...car.querySelectorAll('.car-dot')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const show = (i: number) => {
      idx = (i + slides.length) % slides.length;
      slides.forEach((s, j) => s.classList.toggle('active', j === idx));
      dots.forEach((d, j) => d.classList.toggle('active', j === idx));
    };
    const play = () => { if (!reduce && !timer) timer = setInterval(() => show(idx + 1), 5000); };
    const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
    const manual = (i: number) => { stop(); show(i); play(); };

    car.querySelector('.car-prev')?.addEventListener('click', () => manual(idx - 1));
    car.querySelector('.car-next')?.addEventListener('click', () => manual(idx + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => manual(j)));

    // Swipe (touch)
    let x0 = 0;
    car.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    car.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 45) manual(idx + (dx < 0 ? 1 : -1));
    });

    car.addEventListener('pointerenter', stop);
    car.addEventListener('pointerleave', play);
    play();
  }
</script>

<!-- Atouts -->
<section class="pb-24">
  <div class="wrap grid lg:grid-cols-2 gap-10 lg:gap-16">
    <div class="reveal">
      <p class="eyebrow mb-4">{fr ? 'Les atouts' : 'The highlights'}</p>
      <h2 class="h2">{fr ? 'Pourquoi la Villa Les Zines.' : 'Why Villa Les Zines.'}</h2>
    </div>
    <ul class="space-y-4 reveal">
      {atouts.map((a) => (
        <li class="flex gap-3 text-ink-soft text-lg"><svg class="w-6 h-6 mt-0.5 shrink-0 stroke-terra fill-none" stroke-width="1.6" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>{a}</li>
      ))}
    </ul>
  </div>
</section>

<!-- CTA -->
<section class="pb-28">
  <div class="wrap">
    <div class="card !bg-pine text-white rounded-3xl p-8 sm:p-14 text-center reveal">
      <p class="eyebrow !text-gold mb-3">{fr ? 'Vente de gré à gré' : 'Private sale'}</p>
      <p class="font-serif text-3xl sm:text-4xl mb-3">{fr ? 'Prix sur demande' : 'Price on request'}</p>
      <p class="text-white/75 max-w-xl mx-auto mb-8">
        {fr
          ? 'Pour en savoir plus ou organiser une visite, écrivez-nous : nous répondons personnellement et en toute confidentialité.'
          : 'To find out more or arrange a visit, write to us: we reply personally and confidentially.'}
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href={localizedPath(lang, 'contact')} class="btn btn-primary">{fr ? 'Demander une visite' : 'Request a visit'}</a>
      </div>
    </div>
  </div>
</section>
