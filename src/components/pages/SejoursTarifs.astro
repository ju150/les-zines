---
import type { Lang } from '../../i18n/ui';
import { useTranslations, localizedPath } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';
import rates from '../../data/rates.json';
import { renderAvailability, scopedWeeks } from '../../scripts/availability';
import JsonLd from '../JsonLd.astro';
import { vacationRentalSchema, breadcrumbSchema } from '../../data/schema';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const fr = lang === 'fr';
const reservationBase = localizedPath(lang, 'reservation');

const included = fr
  ? ['Wifi fibre', 'Lave-linge', 'Forfait eau, gaz et électricité (usage limité)', 'Taxe de séjour', 'Ménage de fin de séjour', 'Linge de maison : draps, serviettes, torchons']
  : ['Fibre wifi', 'Washing machine', 'Water, gas and electricity package (normal use)', 'Tourist tax', 'End-of-stay cleaning', 'Household linen: sheets, towels, cloths'];

const tableHtml = renderAvailability(rates.weeks, { mode: 'links', lang, reservationBase });

// Archive de la saison : les semaines déjà passées restent consultables, repliées, pour
// qui veut voir ce qui a été loué (demande du propriétaire — argument pour une vente).
// Elles ne doivent pas s'intercaler dans le tableau : le parcours de réservation passe avant.
const pastWeeks = scopedWeeks(rates.weeks, 'past');
const pastHtml = renderAvailability(rates.weeks, { mode: 'links', lang, reservationBase, scope: 'past' });
const pastLabel = (n: number) =>
  fr
    ? `Voir ${n > 1 ? `les ${n} semaines déjà passées` : 'la semaine déjà passée'}`
    : `Show ${n > 1 ? `the ${n} past weeks` : 'the past week'}`;
---
<JsonLd data={vacationRentalSchema(lang)} />
<JsonLd data={breadcrumbSchema(lang, 'sejours-tarifs', fr ? 'Séjours & Tarifs' : 'Stays & Rates')} />
<PageHeader
  image="/photos/terrasse.webp"
  eyebrow={t('rate_eye')}
  title={t('rate_h')}
  intro={fr
    ? 'Retrouvez les semaines disponibles et faites votre demande de réservation. Courts séjours possibles hors saison.'
    : 'Find the available weeks and send your booking request. Short stays possible off-season.'}
/>

<section class="py-20 sm:py-24">
  <div class="wrap">
    <h2 class="h2 mb-8 reveal">{fr ? 'Tarifs & disponibilités' : 'Rates & availability'}</h2>

    <div id="rates-table" class="av-table card overflow-hidden reveal" data-lang={lang} data-resbase={reservationBase} set:html={tableHtml}></div>

    <details id="past-weeks" class="av-more reveal" hidden={!pastWeeks.length}>
      <summary id="past-summary">{pastLabel(pastWeeks.length)}</summary>
      <div id="past-table" class="av-table card overflow-hidden mt-3" set:html={pastHtml}></div>
    </details>

    <div class="flex flex-wrap items-center gap-4 mt-4 text-xs text-ink-mute reveal">
      <span class="font-semibold uppercase tracking-wide">{fr ? 'Zones scolaires' : 'School zones'} :</span>
      <span class="flex items-center gap-1.5"><span class="zone zone-a">A</span><span class="zone zone-b">B</span><span class="zone zone-c">C</span></span>
      <span class="flex items-center gap-1.5"><span class="av-nozone">—</span>{fr ? 'hors vacances scolaires' : 'outside school holidays'}</span>
    </div>

    <div class="grid sm:grid-cols-2 gap-8 mt-12">
      <div class="reveal">
        <h3 class="h3 mb-4">{fr ? 'Ce qui est inclus' : 'What’s included'}</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1">
          {included.map((i) => (
            <li class="flex gap-3 text-ink-soft py-1"><svg class="w-5 h-5 mt-0.5 shrink-0 stroke-pine-2 fill-none" stroke-width="1.6" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>{i}</li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <h3 class="h3 mb-4">{fr ? 'Bon à savoir' : 'Good to know'}</h3>
        <p class="text-ink-soft mb-5">
          {fr
            ? 'La location se fait à la semaine, du samedi au samedi, en juillet et août. Hors saison, des courts séjours sont possibles : indiquez vos dates au moment de la réservation.'
            : 'Rental is weekly, Saturday to Saturday, in July and August. Off-season, short stays are possible: enter your dates when booking.'}
        </p>
        <a href={reservationBase} class="btn btn-pine">{fr ? 'Réserver un séjour' : 'Book a stay'}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { renderAvailability, scopedWeeks } from '../../scripts/availability';
  const table = document.getElementById('rates-table');
  if (table) {
    const lang = table.dataset.lang || 'fr';
    const fr = lang === 'fr';
    const resBase = table.dataset.resbase || '/reservation';
    const details = document.getElementById('past-weeks') as HTMLDetailsElement | null;
    const summary = document.getElementById('past-summary');
    const pastTable = document.getElementById('past-table');
    // Le SSR est figé à la date du build : c'est ce rendu client, à la vraie date du
    // visiteur, qui décide au final ce qui est encore réservable et ce qui est archivé.
    fetch('/api/rates')
      .then((r) => r.json())
      .then((d) => {
        if (!d?.weeks?.length) return;
        const opts = { mode: 'links' as const, lang, reservationBase: resBase };
        table.innerHTML = renderAvailability(d.weeks, opts);
        if (!details || !summary || !pastTable) return;
        const n = scopedWeeks(d.weeks, 'past').length;
        details.hidden = n === 0;
        if (!n) return;
        summary.textContent = fr
          ? `Voir ${n > 1 ? `les ${n} semaines déjà passées` : 'la semaine déjà passée'}`
          : `Show ${n > 1 ? `the ${n} past weeks` : 'the past week'}`;
        pastTable.innerHTML = renderAvailability(d.weeks, { ...opts, scope: 'past' });
      })
      .catch(() => {});
  }
</script>
